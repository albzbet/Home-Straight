# Copy this file to .env and fill it in from Supabase: Project Settings > API (or the "Connect" button).
# Leave it empty to try the app without accounts: Day 1 still works, saved on the phone only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
