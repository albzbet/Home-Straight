{
  "expo": {
    "name": "homestr8",
    "slug": "homestr8",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.homestr8.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C57950",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "au.homestr8.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17191A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#C57950",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconLeaf",
            "ios": "./assets/icon-leaf.png",
            "android": {
              "foregroundImage": "./assets/icon-leaf-foreground.png",
              "backgroundColor": "#F7F3EC"
            }
          },
          {
            "name": "IconPlain",
            "ios": "./assets/icon-plain.png",
            "android": {
              "foregroundImage": "./assets/icon-plain-foreground.png",
              "backgroundColor": "#55606B"
            }
          }
        ]
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID lets you lock the app so only you can open it."
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "scheme": "homestr8",
    "experiments": {
      "typedRoutes": false
    }
  }
}
